GA_ENVIRONMENT=development
GA_DATABASE_PATH=./data/growth_autopsy.db
GA_SHARED_WORKDIR=./data

GA_GOOGLE_CALENDAR_ID=primary
GA_GOOGLE_TOKEN_FILE=./secrets/google-token.json
GA_CALENDAR_TITLE_PREFIX=[GROWTH AUTOPSY]
GA_DIKSHA_EMAIL=
GA_CALENDAR_LOOKAHEAD_DAYS=30
GA_CALENDAR_LOOKBACK_HOURS=24
GA_PRECALL_START_MINUTES=60
GA_PRECALL_DELIVERY_MINUTES=30

# Free pre-call evidence collectors
GA_PRECALL_RESEARCH_BACKEND=local_free
GA_PRECALL_MAX_PAGES=12
GA_PRECALL_MAX_CONCURRENCY=4
GA_PRECALL_HTTP_TIMEOUT_SECONDS=20
GA_PRECALL_MAX_RESPONSE_BYTES=2097152
GA_PRECALL_SEARCH_ENABLED=true
GA_PRECALL_SEARCH_RESULTS_PER_QUERY=5
GA_PRECALL_SEARCH_TIMEOUT_SECONDS=20
GA_PRECALL_PAGESPEED_ENABLED=true
GA_PAGESPEED_API_KEY=
GA_PRECALL_PAGESPEED_TIMEOUT_SECONDS=60
GA_PRECALL_LOCAL_LIGHTHOUSE_ENABLED=true
GA_LIGHTHOUSE_EXECUTABLE=./node_modules/.bin/lighthouse
GA_PRECALL_LOCAL_LIGHTHOUSE_TIMEOUT_SECONDS=90
GA_PRECALL_COLLECTION_STALE_MINUTES=20
GA_PRECALL_MAX_PARALLEL_APPOINTMENTS=2

GA_HERMES_BASE_URL=http://127.0.0.1:8642
GA_HERMES_API_KEY=replace-with-hermes-api-server-key
GA_HERMES_DELIVERY_TARGET=local
GA_HERMES_CRON_OUTPUT_DIR=/Users/your-user/.hermes/cron/output

GA_ENABLE_BACKGROUND_SYNC=true
GA_BACKGROUND_SYNC_INTERVAL_SECONDS=60

GA_FATHOM_WEBHOOK_SECRET=whsec_replace_me
GA_FATHOM_API_KEY=
GA_FATHOM_MATCH_WINDOW_MINUTES=20
GA_MAX_FATHOM_WEBHOOK_BYTES=5242880

GA_INTERNAL_API_KEY=replace-with-random-local-key
